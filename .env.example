# Andmebaas
# POSTGRES_USER=praktikum
# POSTGRES_PASSWORD=praktikum
# POSTGRES_DB=praktikum
# DB_PORT_HOST=55432

# Airflow (kui kasutatakse)
# AIRFLOW_UID=50000
# AIRFLOW_USER=airflow
# AIRFLOW_PASSWORD=airflow
# AIRFLOW_DB=airflow

# Näidikulaud (kui kasutatakse)
# DASHBOARD_PORT_HOST=8501
# DASHBOARD_AUTOREFRESH_SECONDS=30

# Muud projekti-spetsiifilised muutujad
# API_URL=https://...

# MAAVÄRINATE projekti-spetsiifilised muutujad
USGS_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
DAYS=30

# 1. Prosgres muutujad
# need samad muutujad peavad olema ka .Yml failis (muutsin need yml-is ära)
# vajalikud pg_ingest_usgs.py faili käivitamiseks
MAAVARIN_USER= meiegrupp
MAAVARIN_PW= meieparool
PGRES_MAAVARIN_DB=MAAVARIN_PG
DB_PORT_HOST=55432

# 1. vajalikud ingest_usgs.py faili käivitamiseks
# DuckDb_muutujad
DB_PATH=earthquakes.duckdb
TABLE_NAME=raw_usgs_earthquakes

# 2. Open-Meteo baas URL
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Kontrollid USGS datale
# MAX magnituud: 9.5 (kõrgeim usaldusväärselt mõõdetud) 22. mai 1960
# MIN magnituud "negatiivne" ei ole andmeviga  
# USGS ja teised seismoloogia keskused on registreerinud isegi: –3.0 (äärmiselt haruldane, väga lokaalne)
MAG_MIN=-3.0
MAG_MAX=10

# kaustade aadressid
# SQL päringud
SQL_KAUSTA_URL=transformations/sql/



